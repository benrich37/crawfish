# fcc Al, 1 atom, 8x8x8 mesh, Fermi smearing 0.01 Ha: crawfish test fixture for occupation helpers (finding F8)
lattice \
    0.0 3.8265 3.8265 \
    3.8265 0.0 3.8265 \
    3.8265 3.8265 0.0
coords-type Lattice
ion Al 0 0 0 0
ion-species /Users/richb/Desktop/jdftx_hold/build_master/pseudopotentials/GBRV/al_pbe_v1.uspp
elec-ex-corr gga-PBE
elec-cutoff 20 100
elec-n-bands 8
elec-smearing Fermi 0.01
spintype no-spin
kpoint-folding 8 8 8
converge-empty-states yes
electronic-minimize energyDiffThreshold 1e-8
band-projection-params yes no
dump-name $VAR
dump End BandEigs BandProjections Fillings Kpoints EigStats
