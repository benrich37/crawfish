+//Apply the Kohn-Sham Hamiltonian at the current state to an arbitrary ColumnBundle Y (same terms as
+//ElecVars::applyHamiltonian: local potential, ultrasoft augmentation, kinetic and nonlocal parts).
+//Meta-GGA, DFT+U and exact exchange contributions are not included (a warning is logged by the caller).
+static ColumnBundle applyKohnShamHamiltonian(const Everything& e, const ColumnBundle& Y)
+{	const IonInfo& iInfo = e.iInfo;
+	const QuantumNumber& qnum = *(Y.qnum);
+	std::vector<matrix> VdagY, HVdagY(iInfo.species.size());
+	iInfo.project(Y, VdagY);
+	ColumnBundle HY = Idag_DiagV_I(Y, e.eVars.Vscloc);
+	iInfo.augmentDensitySphericalGrad(qnum, VdagY, HVdagY);
+	HY += (-0.5) * L(Y);
+	iInfo.EnlAndGrad(qnum, diagMatrix(Y.nCols(), 0.), VdagY, HVdagY);
+	iInfo.projectGrad(HVdagY, Y, HY);
+	return HY;
+}
+
+void dumpAOmatrices(const Everything& e, const char* fnameS, const char* fnameH)
+{	const ElecVars& eVars = e.eVars;
+	const ElecInfo& eInfo = e.eInfo;
+	const IonInfo& iInfo = e.iInfo;
+	if(e.exCorr.needsKEdensity() or eInfo.hasU or e.exCorr.exxFactor())
+		logPrintf("\nWARNING: aoHamiltonian omits meta-GGA, DFT+U and exact-exchange terms.\n");
+	FILE *fpS = 0, *fpH = 0;
+	if(mpiWorld->isHead())
+	{	fpS = fopen(fnameS, "wb");
+		fpH = fopen(fnameH, "wb");
+		if(!fpS || !fpH) die_alone("Error opening AO matrix files for writing.\n");
+	}
+	int nOrbitals = iInfo.nAtomicOrbitals();
+	double errEigsMax = 0.; //self-check: same operator applied to the bands must reproduce the eigenvalues
+	for(int q=0; q<eInfo.nStates; q++)
+	{	matrix S, H;
+		if(eInfo.isMine(q))
+		{	ColumnBundle psi = iInfo.getAtomicOrbitals(q, false);
+			S = psi ^ O(psi);
+			H = psi ^ applyKohnShamHamiltonian(e, psi);
+			matrix CdagHC = eVars.C[q] ^ applyKohnShamHamiltonian(e, eVars.C[q]);
+			for(int b=0; b<eInfo.nBands; b++)
+				errEigsMax = std::max(errEigsMax, fabs(CdagHC(b,b).real() - eVars.Hsub_eigs[q][b]));
+			if(not mpiWorld->isHead())
+			{	mpiWorld->sendData(S, 0, 2*q);
+				mpiWorld->sendData(H, 0, 2*q+1);
+			}
+		}
+		if(mpiWorld->isHead())
+		{	if(not eInfo.isMine(q))
+			{	S.init(nOrbitals, nOrbitals);
+				H.init(nOrbitals, nOrbitals);
+				mpiWorld->recvData(S, eInfo.whose(q), 2*q);
+				mpiWorld->recvData(H, eInfo.whose(q), 2*q+1);
+			}
+			S.write(fpS);
+			H.write(fpH);
+		}
+	}
+	if(mpiWorld->isHead()) { fclose(fpS); fclose(fpH); }
+	mpiWorld->allReduce(errEigsMax, MPIUtil::ReduceMax);
+	logPrintf("(self-check: max |<psi_b|H|psi_b> - eig_b| = %.2le Eh) ", errEigsMax);
+}
